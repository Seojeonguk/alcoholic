rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 게시글 사진: posts/{uid}/{파일}. 본인 폴더에만 이미지를 올릴 수 있음
    match /posts/{uid}/{fileId} {
      // read에는 목록 조회(list)도 들어 있어 본인만 허용. 앱은 토큰이 붙은 다운로드 URL로 사진을 보여 주므로 영향 없음
      allow read: if request.auth != null && request.auth.uid == uid;
      // 같은 경로의 파일을 덮어쓰지 못하게 기존 파일이 없을 때만 허용
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.size < 10 * 1024 * 1024
        // 앱이 넣는 형식(lib/imageContentType.js)만 받음. SVG처럼 스크립트가 들 수 있는 형식은 막음
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif|gif)');
      allow update: if false;
      // 탈퇴할 때 본인 폴더의 사진을 지움
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 경로에 uid가 없던 예전 사진(posts/{파일})과 posts 폴더 전체 목록은 허용하지 않음(#319)
  }
}
