{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "react-native": {
    "messaging_auto_init_enabled": false
  },
  "emulators": {
    "firestore": {
      "port": 8180,
      "websocketPort": 9160
    },
    "storage": {
      "port": 9199
    },
    "singleProjectMode": true,
    "ui": {
      "enabled": false
    }
  }
}
