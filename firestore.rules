rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // 사용자 정보: 문서 ID가 이메일. 회원가입 직후(인증 전)에 만들어짐
    // 예전에는 글 ID 목록(posts)을 따로 적었지만 읽는 곳이 없어 그만씀(#292). 이미 있는 문서의 posts는 그대로 둠
    match /users/{email} {
      allow read: if signedIn() && myEmail() == email;
      // 앱은 예전 규칙과도 맞도록 빈 posts를 넣어 만듦. posts는 없거나 빈 배열만 받아 줌
      allow create: if signedIn() && myEmail() == email
        && request.resource.data.keys().hasOnly(['userEmail', 'posts'])
        && request.resource.data.userEmail == email
        && request.resource.data.get('posts', []) == [];
      // 고칠 것이 없으므로 update는 허용하지 않음
      // 탈퇴할 때 지움. 인증 전에 탈퇴하는 경우도 있어 이메일 인증은 보지 않음
      allow delete: if signedIn() && myEmail() == email;
    }

    // 태그는 1~20자. 규칙에는 반복문이 없어서 줄바꿈으로 이어 붙인 뒤 정규식으로 하나씩 검사함
    // join이 숫자도 글자로 바꾸므로 원소 타입은 보지 않음(길이 · 개수 상한은 똑같이 걸림)
    function validTags(tags) {
      return tags is list
        && tags.size() <= 20
        && (tags.size() == 0 || tags.join('\n').matches('[^\n]{1,20}(\n[^\n]{1,20})*'));
    }

    // 마신 날짜: 앱의 toLocalDateString이 만드는 YYYY-MM-DD. matches는 문자열 전체가 맞아야 해서 길이도 10자로 정해짐
    function validDay(day) {
      return day is string
        && day.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }

    // 사진 하나: 다운로드 URL(200자 남짓). 버킷 이름이 길어도 들어가게 1000자까지 받음
    function validPhotoAt(photos, i) {
      return photos.size() <= i
        || (photos[i] is string && photos[i].size() >= 1 && photos[i].size() <= 1000);
    }

    // 사진은 10장까지. 반복문이 없어서 칸마다 검사함
    function validPhotos(photos) {
      return photos is list && photos.size() <= 10
        && validPhotoAt(photos, 0) && validPhotoAt(photos, 1) && validPhotoAt(photos, 2)
        && validPhotoAt(photos, 3) && validPhotoAt(photos, 4) && validPhotoAt(photos, 5)
        && validPhotoAt(photos, 6) && validPhotoAt(photos, 7) && validPhotoAt(photos, 8)
        && validPhotoAt(photos, 9);
    }

    // 별점(#341): 없거나 null(고르지 않음), 있으면 1~5 정수. 앱의 constants/drinkTypes.js의 MAX_RATING과 같아야 함
    function validRating(data) {
      return !('rating' in data) || data.rating == null
        || (data.rating is int && data.rating >= 1 && data.rating <= 5);
    }

    // 주종(#341): 없거나 null(고르지 않음), 있으면 정해 둔 코드. 앱의 constants/drinkTypes.js와 같아야 함
    function validDrinkType(data) {
      return !('drinkType' in data) || data.drinkType == null
        || (data.drinkType is string && data.drinkType in ['soju', 'beer', 'wine', 'whisky',
          'spirits', 'baijiu', 'makgeolli', 'traditional', 'sake', 'cocktail', 'other']);
    }

    // 갤러리 썸네일(#338): 대표 사진을 줄인 사진의 다운로드 URL. 없거나 null이면 갤러리가 대표 사진을 보여 줌
    function validThumbnail(data) {
      return !('thumbnail' in data) || data.thumbnail == null
        || (data.thumbnail is string && data.thumbnail.size() >= 1 && data.thumbnail.size() <= 1000);
    }

    // 길이 · 개수 상한은 앱의 constants/postLimits.js와 같아야 함
    function validPost(data) {
      return data.keys().hasOnly(['title', 'day', 'photos', 'content', 'location', 'tags', 'rating',
          'drinkType', 'thumbnail', 'writer', 'createdAt'])
        && data.writer == myEmail()
        && data.title is string && data.title.size() <= 40
        && validDay(data.day)
        && validPhotos(data.photos)
        && data.content is string && data.content.size() <= 2000
        && data.location is string && data.location.size() <= 50
        && validTags(data.tags)
        && validRating(data)
        && validDrinkType(data)
        && validThumbnail(data)
        && data.createdAt is timestamp;
    }

    // 게시글: writer 필드의 이메일 주인만 읽고 쓸 수 있음
    match /posts/{postId} {
      allow read: if verified() && resource.data.writer == myEmail();
      allow create: if verified() && validPost(request.resource.data);
      allow update: if verified() && resource.data.writer == myEmail()
        && validPost(request.resource.data);
      allow delete: if verified() && resource.data.writer == myEmail();
    }
  }
}
